{
  "name": "intervyn",
  "version": "0.3.0",
  "private": true,
  "description": "Open-source (MIT), voice-first AI mock-interview platform. English-first, multilingual.",
  "license": "MIT",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "gen:schema": "turbo run gen:schema",
    "dev": "turbo run dev",
    "lint": "prettier --check \"frontend/src/**/*.{ts,tsx}\" \"frontend/tests/**/*.{ts,tsx}\" \"frontend/cli/src/**/*.ts\" \"frontend/packages/shared/src/**/*.ts\" \"frontend/packages/shared/scripts/**/*.mts\" && pnpm --filter @intervyn/agent run lint",
    "format": "prettier --write \"frontend/src/**/*.{ts,tsx}\" \"frontend/tests/**/*.{ts,tsx}\" \"frontend/cli/src/**/*.ts\" \"frontend/packages/shared/src/**/*.ts\" \"frontend/packages/shared/scripts/**/*.mts\"",
    "intervyn": "node frontend/cli/dist/index.js"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.6",
    "typescript": "~5.9.3"
  }
}
