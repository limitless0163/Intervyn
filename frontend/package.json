{
  "name": "@intervyn/web",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build && pnpm build:web",
    "typecheck": "turbo run typecheck && pnpm typecheck:web",
    "test": "turbo run test && pnpm test:web",
    "test:sidecar": "uv --directory ../backend/services/lightrag run pytest",
    "test:all": "pnpm test && pnpm test:sidecar",
    "test:live": "uv --directory ../backend run --extra livekit pytest -q",
    "gen:schema": "turbo run gen:schema",
    "dev": "turbo run build --filter @intervyn/shared --filter @intervyn/ee && next dev",
    "lint": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"cli/src/**/*.ts\" \"packages/shared/src/**/*.ts\" \"packages/shared/scripts/**/*.mts\" && pnpm --filter @intervyn/agent run lint",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"cli/src/**/*.ts\" \"packages/shared/src/**/*.ts\" \"packages/shared/scripts/**/*.mts\"",
    "intervyn": "cd .. && node frontend/cli/dist/index.js",
    "start": "next start",
    "build:web": "next build",
    "typecheck:web": "next typegen && tsc --noEmit",
    "test:web": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@intervyn/ee": "workspace:*",
    "@intervyn/shared": "workspace:*",
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.2.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.116.0",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "livekit-client": "^2.22.2",
    "livekit-server-sdk": "^2.17.0",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10",
    "prettier": "^3.9.6",
    "turbo": "^2.10.6"
  },
  "description": "Open-source (MIT), voice-first AI mock-interview platform. English-first, multilingual.",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  }
}
